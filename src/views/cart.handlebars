{{#if cart}}
    <h1>Carrito - ID: {{cartId}}</h1>
    <ul>
        {{#each products}}
            <li>{{this.product.title}} - Cantidad: {{this.quantity}} - Precio: ${{this.product.price}}</li>
        {{/each}}
    </ul>
    <a href="/products">Volver a Productos</a>
{{else}}
    <h1>Carrito no encontrado</h1>
    <a href="/products">Volver a Productos</a>
{{/if}}